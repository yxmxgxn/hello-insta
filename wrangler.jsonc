{
  "name": "hello-insta",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Worker を通すのは API だけ。画面(静的ファイル)は Worker を通さず配信する
    "run_worker_first": ["/api/*"]
  },
  // 公開URL insta.karin-archive.com はダッシュボードで付けたカスタムドメイン
  // (Workers & Pages → hello-insta → 設定 → ドメインとルート)。
  // ここに routes を書くとデプロイ用トークンにゾーンの権限が要るので書かない
  // 1分あたりの同一IPからの公開API呼び出し上限(Workers のレート制限バインディング)
  "unsafe": {
    "bindings": [
      { "name": "RL", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hello-insta",
      // ダッシュボード → ストレージとデータベース → D1 → hello-insta
      "database_id": "fd432d2a-d80f-4105-9c47-fe8802e0b5d9"
    }
  ]
}
